# SAMS Mobile — copy to .env in packages/mobile (not committed)
# Production API (default if unset):
EXPO_PUBLIC_API_URL=https://api.smart-managment.com/api/v1

# App host (if API is proxied through the web domain):
# EXPO_PUBLIC_API_URL=https://app.smart-managment.com/api/v1

# Local backend (Expo Go on physical device — use your LAN IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3001/api/v1
