DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sams_dev"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-to-a-long-random-secret-at-least-64-chars"
JWT_REFRESH_SECRET="change-me-to-a-different-long-random-secret-at-least-64-chars"
