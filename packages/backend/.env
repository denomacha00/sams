LICENSE_SECRET="change-me-to-a-long-random-license-hmac-secret-at-least-64-chars"
NODE_ENV="development"
PORT="3001"
SUPER_ADMIN_HOST_CHECK="disabled"

# Conversation Memory Encryption
CONVERSATION_MASTER_KEY=sams-conv-encryption-key-2024-secure-random-value

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Development: allow all origins (proxy handles it via Vite)
# Production: set to your exact frontend domain, e.g. https://app.smart-managment.com
CORS_ORIGIN="*"

# ─── App URL (used in password reset email links) ─────────────────────────────
# Development: local frontend
# Production: https://app.smart-managment.com
APP_URL="http://localhost:3000"

# ─── Super Admin Host ─────────────────────────────────────────────────────────
# Production value: super.smart-managment.com
# SUPER_ADMIN_HOST_CHECK is already "disabled" above for local dev — leave it
SUPER_ADMIN_HOST="super.smart-managment.com"

# ─── M-Pesa ───────────────────────────────────────────────────────────────────
