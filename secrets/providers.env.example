# Third-party & sensitive API secrets — copy to ONE of (never commit the real file):
#   /var/www/sams/secrets/providers.env   (production VPS, recommended)
#   secrets/providers.env               (local repo)
#   packages/backend/.env.secrets       (local dev alternative)
#
# Loaded AFTER packages/backend/.env; later files override matching keys.
# git pull and scripts/deploy-production.sh never modify these paths.

# ─── AI (OpenRouter primary, Groq fallback — use scripts/write-providers-env.sh) ─
OPENAI_API_KEY="sk-or-v1-your-openrouter-key"
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
OPENAI_MODEL="meta-llama/llama-3.1-8b-instruct:free"
OPENAI_FALLBACK_KEY="gsk_your-groq-api-key"
OPENAI_FALLBACK_URL="https://api.groq.com/openai/v1"
OPENAI_FALLBACK_MODEL="llama-3.3-70b-versatile"
# Vision must be a multimodal model (OpenRouter). Groq fallback is text-only.
VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"

# ─── Africa's Talking (SMS / OTP) ─────────────────────────────────────────────
AT_API_KEY="your-africastalking-api-key"
AT_USERNAME="sandbox"
AT_SENDER_ID="SAMS"
# AT_SANDBOX_SENDER_ID="AFRICASTKNG"

# ─── SMTP (email) ─────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-smtp-app-password"
SMTP_FROM_NAME="SAMS"
SMTP_FROM_EMAIL="your-email@gmail.com"

# ─── M-Pesa (Daraja) ──────────────────────────────────────────────────────────
MPESA_CONSUMER_KEY="your-mpesa-consumer-key"
MPESA_CONSUMER_SECRET="your-mpesa-consumer-secret"
MPESA_SHORTCODE="4158238"
MPESA_PASSKEY="your-mpesa-passkey"
MPESA_CALLBACK_URL="https://api.smart-managment.com/api/v1/payments/callback"

# ─── Conversation memory (required for encrypted AI chat threads) ───────────
# Generate: openssl rand -base64 48  (must be 32+ characters)
CONVERSATION_MASTER_KEY="replace-with-32-plus-character-random-secret"
# CONVERSATION_MASTER_KEY_PREVIOUS="previous-key-after-rotation"

# ─── Biometric (required for production go-live) ─────────────────────────────
# Generate: openssl rand -base64 48  (must be 32+ characters)
BIOMETRIC_MASTER_KEY="replace-with-openssl-rand-base64-48-output"
# BIOMETRIC_ENCRYPTION_KEY="64-hex-chars-for-aes-256"

# ─── App crypto (required in production; set-production-env.sh can generate) ──
# JWT_SECRET="64-plus-char-random"
# JWT_REFRESH_SECRET="64-plus-char-random-different"
# QR_SECRET="64-plus-char-random"
# LICENSE_SECRET="64-plus-char-random-different-from-jwt"
# SUPER_ADMIN_PASSWORD="change-after-first-login"
